.DS_Store
node_modules/
target/
dist/
out/
out_eval/
wasm/target/
src_vis/wasm/*
!src_vis/wasm/.gitkeep
tools/target/
tools.zip
# 追加した共有の評価セットは生成手順から作り直す (AGENTS.md)。
tools/in_*/
results/**
!results/score_summary.csv
!results/score_detail.csv
# 評価の個票は評価セット別に保存し、tools/in だけを共有する。
!results/eval_records/
!results/eval_records/tools/
!results/eval_records/tools/in.jsonl
*.log
__pycache__/
config/local_profiles.json

# リポジトリ直下の *.cpp 除外を、この C++ テンプレート配下では解除する。
!*.cpp

# 公式 vis の既定出力 (cargo run --bin vis で cwd に書かれる)
vis.html

# Claude Code の個人設定
.claude/settings.local.json

# adhoc ではコードと Markdown だけを Git で管理する。データは各端末に置く (AGENTS.md)。
/adhoc/**
!/adhoc/**/
!/adhoc/**/*.cpp
!/adhoc/**/*.hpp
!/adhoc/**/*.h
!/adhoc/**/*.inc
!/adhoc/**/*.py
!/adhoc/**/*.sh
!/adhoc/**/*.js
!/adhoc/**/*.rs
!/adhoc/**/*.md
!/adhoc/**/.gitkeep
